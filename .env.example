# UGCORA Studio - Environment Configuration

# Application
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000

# Security
SESSION_SECRET=change-this-to-a-long-random-string

# Private authentication (single owner)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# NVIDIA
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Video provider ("nvidia" or future providers)
VIDEO_PROVIDER=nvidia

# Voice provider (future-ready; "none" by default)
VOICE_PROVIDER=none

# Database
DATABASE_URL=sqlite:///./data/ugcora.db
